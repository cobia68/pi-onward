{
  "name": "@cobia/pi-onward",
  "version": "0.1.0",
  "description": "Keep a pi run going after it ends in an error: user-written rules decide whether to send a visible message or silently resend, with per-rule budgets, backoff and a same-error stop.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "retry",
    "auto-continue"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobia68/pi-onward.git"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "files": [
    "src/",
    "example.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:extension": "node scripts/check-extension.mjs",
    "check": "npm run check:biome && npm run typecheck && npm test && npm run check:extension",
    "prepublishOnly": "npm run check",
    "lint": "node scripts/biome-check.mjs --lint",
    "format": "node scripts/biome-check.mjs --write",
    "check:biome": "node scripts/biome-check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
