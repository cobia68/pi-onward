{
  "name": "@cobia/pi-onward",
  "version": "0.4.0",
  "description": "pi 出错或空回复时，按阶段策略恢复并调用扩展命令或具名动作",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "retry",
    "auto-continue"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobia68/pi-onward.git"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "exports": {
    "./actions": "./src/actions/protocol.ts"
  },
  "files": [
    "src/",
    "docs/",
    "example.json",
    "onward.schema.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:extension": "node scripts/check-extension.mjs",
    "gen:schema": "node --import tsx scripts/generate-schema.ts",
    "check": "npm run check:biome && npm run typecheck && npm test && npm run check:extension",
    "prepublishOnly": "npm run check",
    "lint": "node scripts/biome-check.mjs --lint",
    "format": "node scripts/biome-check.mjs --write",
    "check:biome": "node scripts/biome-check.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
